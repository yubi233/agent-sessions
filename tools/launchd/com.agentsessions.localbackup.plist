<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- v0.9.7 阶段 2.2：本地栈每日备份（09:00）。安装：
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.agentsessions.localbackup.plist
     手动触发：launchctl kickstart gui/$(id -u)/com.agentsessions.localbackup -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentsessions.localbackup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yubi/code/agentProject/agent-sessions/tools/backup_local_stack.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/yubi/code/agentProject/agent-sessions/.task/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yubi/code/agentProject/agent-sessions/.task/backup.log</string>
</dict>
</plist>
