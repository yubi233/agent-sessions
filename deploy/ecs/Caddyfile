# Caddy TLS 终结配置（自签证书口径，计划 §1 TLS 降级决策）。
# 证书为 openssl 生成的自签叶子证书（SAN=39.106.135.11，10 年），
# 客户端按 SHA-256 指纹显式放行；auto_https off 禁用 Caddy 自动签发，
# 防止 ACME/内部 CA 产物导致指纹漂移。
# 阶段 8：同源路由拆分——/v1/* 反代 Relay；/web/*、/admin/* 为静态只读入口
# （『两者都公网』用户裁决）；/ 重定向到 Web 入口。
{
	auto_https off
	admin off
}

# 80 端口仅做 HTTPS 重定向（计划 §2：HTTP 只用于重定向）。
:80 {
	redir https://39.106.135.11{uri} permanent
}

:443 {
	tls /etc/agent-sessions/certs/relay.crt /etc/agent-sessions/certs/relay.key

	# Relay API：同源反代（Web/Admin 以 VITE_RELAY_URL="" 同源请求 /v1/*）。
	handle /v1/* {
		reverse_proxy relay:8787
	}

	# 健康探针直通（外部 smoke 与客户端可达性检查用）。
	handle /healthz {
		reverse_proxy relay:8787
	}
	handle /readyz {
		reverse_proxy relay:8787
	}

	# Web 只读客户端静态入口（hash 路由，vite --base=/web/ 构建）。
	handle_path /web/* {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# Admin 运维平台静态入口（hash 路由，vite --base=/admin/ 构建）。
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# 根路径重定向到 Web 入口。
	redir / /web/ permanent
}
