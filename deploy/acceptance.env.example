# 阿里云真实部署与 Android 真机验收的环境输入模板。
# 复制为 deploy/acceptance.env 后按需填写；真实文件已被 .gitignore 忽略，权限应为 600。
# 只允许填值本身或密钥的本地路径；私钥/密码/token 不得出现在文档、日志、截图或测试报告中。
# 对应计划：docs/zh/迭代计划/阿里云真实部署与Android真机测试计划-2026-09-11.md §6。

# ---- ECS 与 SSH（只填路径与地址类事实，密钥本身留在 ~/.ssh 等仓库外位置）----
AGENT_SESSIONS_ACC_ECS_HOST=
AGENT_SESSIONS_ACC_ECS_REGION=
AGENT_SESSIONS_ACC_ECS_ARCH=x86_64
AGENT_SESSIONS_ACC_ECS_OS=
AGENT_SESSIONS_ACC_SSH_PORT=22
AGENT_SESSIONS_ACC_SSH_USER=
AGENT_SESSIONS_ACC_SSH_KEY_PATH=
AGENT_SESSIONS_ACC_SSH_SUDO=docker

# ---- 安全组 / 防火墙 ----
AGENT_SESSIONS_ACC_SSH_SOURCE_CIDR=
AGENT_SESSIONS_ACC_HTTPS_PORT=443
AGENT_SESSIONS_ACC_RELAY_PORT_PUBLIC=false

# ---- DNS / TLS ----
AGENT_SESSIONS_ACC_DOMAIN=
AGENT_SESSIONS_ACC_TLS_PROXY=caddy
# TLS 口径：acme（有域名）| self-signed（裸 IP 自签，客户端显式放行）
AGENT_SESSIONS_ACC_TLS_MODE=self-signed
# 客户端放行自签证书的明确授权；true 必须是用户显式决策，不得默认开启
AGENT_SESSIONS_ACC_TLS_BYPASS_CONFIRMED=false
# 自签证书 SHA-256 指纹；部署生成证书后回填，客户端按指纹放行而非信任一切
AGENT_SESSIONS_ACC_TLS_FINGERPRINT=
AGENT_SESSIONS_ACME_EMAIL=

# ---- 数据卷 / 备份 ----
AGENT_SESSIONS_ACC_DATA_VOLUME=relay-data
AGENT_SESSIONS_ACC_BACKUP_DIR=
AGENT_SESSIONS_ACC_BACKUP_RETENTION_DAYS=7
AGENT_SESSIONS_ACC_ALLOW_RESTORE_DRILL=false

# ---- 凭据注入方式与测试账号（env|secret-manager|ci）----
AGENT_SESSIONS_ACC_SECRET_SOURCE=env
AGENT_SESSIONS_ACC_TEST_ACCOUNT=
# 测试账号口令/恢复码只在真实 acceptance.env 中填写，模板保持为空。
AGENT_SESSIONS_ACC_TEST_ACCOUNT_SECRET=

# ---- Daemon / Workspace / 真实 Provider 授权 ----
AGENT_SESSIONS_ACC_ALLOW_TEST_DAEMON=false
AGENT_SESSIONS_ACC_ALLOW_TEST_WORKSPACE=false
AGENT_SESSIONS_ACC_ALLOW_REAL_PROVIDER=false
# 关键事实：DSH 不需要任何 API KEY——渠道与凭据由 DSH/ACP 自身配置解析，
# 不得为 DSH 注入或要求凭据。API KEY 字段仅留给未来需要 key 的 provider。
AGENT_SESSIONS_ACC_PROVIDER_NAME=
AGENT_SESSIONS_ACC_PROVIDER_MODEL=
AGENT_SESSIONS_ACC_PROVIDER_CHANNEL=
AGENT_SESSIONS_ACC_PROVIDER_BUDGET_LIMIT=
AGENT_SESSIONS_ACC_PROVIDER_STOP_LIMIT=
AGENT_SESSIONS_ACC_PROVIDER_API_KEY=

# ---- Android 真机 ----
AGENT_SESSIONS_ACC_ANDROID_MODEL=
AGENT_SESSIONS_ACC_ANDROID_API=
AGENT_SESSIONS_ACC_ADB_SERIAL=
AGENT_SESSIONS_ACC_ANDROID_USB_DEBUG=false
AGENT_SESSIONS_ACC_TEST_PC_NETWORK=

# ---- 验收入口与证据授权 ----
AGENT_SESSIONS_ACC_WEB_ADMIN_ENTRY=false
AGENT_SESSIONS_ACC_ALLOW_RECORDING=false
