# 本地开发环境变量示例。复制为 .env 后按需修改，禁止提交真实密钥。

# Relay HTTP 监听地址
AGENT_SESSIONS_RELAY_ADDR=127.0.0.1:8787

# SQLite 权威库路径；测试使用独立临时文件
AGENT_SESSIONS_SQLITE_PATH=./data/relay.db

# 访问令牌与刷新令牌 TTL（秒）
AGENT_SESSIONS_ACCESS_TTL=900
AGENT_SESSIONS_REFRESH_TTL=2592000

# Web / Admin 开发端口
AGENT_SESSIONS_WEB_PORT=5173
AGENT_SESSIONS_ADMIN_PORT=5174

# 日志级别；普通日志不得输出 token、正文或密钥
AGENT_SESSIONS_LOG_LEVEL=info

# 可选：真实 Provider live gate。未授权时保持空，测试标记 blocked。
# AGENT_SESSIONS_CLAUDE_BIN=
# AGENT_SESSIONS_CODEX_BIN=
# AGENT_SESSIONS_OPENCODE_URL=
# AGENT_SESSIONS_OPENCLAW_URL=
